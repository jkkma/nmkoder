<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway compile-check for Nmkoder's #if WINDOWS code on a non-Windows host. Copied
       to the scratchpad; __WINAPPSDK_VERSION__ and __REPO__ are substituted by the setup step
       in SKILL.md. EnableWindowsTargeting lets a Linux/macOS SDK evaluate the Windows TFM,
       and excluding the App SDK's build assets is what skips the MSIX targets (MakePri.exe
       and friends) that cannot run here - IncludeAssets="compile" keeps exactly the API
       surface the check needs. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1998;CS4014</NoWarn>
    <!-- Only the files named below are compiled; the harness owns its own file list. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="__WINAPPSDK_VERSION__"
                      IncludeAssets="compile"
                      ExcludeAssets="build;buildTransitive;native;runtime;analyzers" />
    <!-- WindowsToast touches Dispatcher.UIThread and WindowState, so the real Avalonia beats
         stubbing those namespaces; versions are substituted from the app's csproj. -->
    <PackageReference Include="Avalonia" Version="__AVALONIA_VERSION__" />
    <PackageReference Include="Avalonia.Desktop" Version="__AVALONIA_VERSION__" />
  </ItemGroup>

  <ItemGroup>
    <!-- The files under check. Re-grep for '#if WINDOWS' before trusting this list. -->
    <Compile Include="__REPO__/Nmkoder/OS/WindowsToast.cs" />
    <!-- Stubs for whatever those files touch from the rest of the app; create beside this
         csproj. Delete the line if no stubs are needed. -->
    <Compile Include="Stubs.cs" Condition="Exists('Stubs.cs')" />
  </ItemGroup>

</Project>
