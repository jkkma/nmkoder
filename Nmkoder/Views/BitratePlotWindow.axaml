<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Nmkoder.Controls"
        x:Class="Nmkoder.Views.BitratePlotWindow"
        Title="Bitrate Chart"
        Width="1000" Height="560"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto" Margin="12">
    <!-- The plot sits on the sunken surface so its gridlines read against something -->
    <Border Grid.Row="0" Background="{DynamicResource NmkoderSunken}"
            BorderBrush="{DynamicResource NmkoderBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="4">
      <ctrl:BitrateChart x:Name="Chart" />
    </Border>
    <TextBlock Grid.Row="1" x:Name="InfoLabel" Classes="dim" Margin="0,8,0,0"
               Text="Drag to select a range. Double click to reset." />
  </Grid>

</Window>
