<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nmkoder.Views.EncoderArgInfoWindow"
        Title="Argument Details"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
    <TextBlock Grid.Row="0" x:Name="ArgNameLabel" FontSize="18" FontWeight="Bold"
               Foreground="{DynamicResource NmkoderHeaderText}"
               FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" TextWrapping="Wrap" />

    <!-- The same one-liner the grid shows, repeated so the ranges and defaults are on screen
         next to the prose that explains them. -->
    <TextBlock Grid.Row="1" x:Name="SummaryLabel" Classes="dim" TextWrapping="Wrap" Margin="0,4,0,10" />

    <ScrollViewer Grid.Row="2">
      <StackPanel Spacing="4">
        <TextBlock x:Name="DetailsLabel" TextWrapping="Wrap" LineHeight="20" />

        <TextBlock x:Name="ExamplesHeader" Classes="h" Text="EXAMPLES" IsVisible="False" />
        <!-- The value column sizes to the values rather than to a fixed 110, which cut off every
             example that is a path - "/path/to/RPU.bin" arrived as "/path/to/RPU." - and there is
             no reading a truncated example, the value being the thing to copy.

             Shared across the rows so the explanations still line up: each row is its own Grid, so
             an Auto column on its own would measure that row alone and leave the second column
             starting at a different place on every line. Capped rather than unbounded, because
             x265's master-display examples are 69 characters and would take the window; those wrap
             inside the chip instead of squeezing the explanation beside them into nothing. -->
        <ItemsControl x:Name="ExamplesList" Grid.IsSharedSizeScope="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ExampleValue" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource NmkoderSunken}" CornerRadius="4" Padding="6,2"
                        MaxWidth="340" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Value}" TextWrapping="Wrap"
                             FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="8,2,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="3" Content="Close" HorizontalAlignment="Right" MinWidth="100" Margin="0,12,0,0"
            IsDefault="True" IsCancel="True" Click="Close_Click" />
  </Grid>

</Window>
