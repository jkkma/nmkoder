<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nmkoder.Views.EditCommandWindow"
        Title="Edit Arguments"
        Width="900" Height="380"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <TextBlock Grid.Row="0" Classes="dim" Margin="0,0,0,8"
               Text="Review or edit the command line before it runs. Clearing the box cancels the task." />

    <TextBox Grid.Row="1" x:Name="ArgsBox" Classes="mono" AcceptsReturn="True" TextWrapping="Wrap" />

    <Button Grid.Row="2" Classes="accent" Content="Run" HorizontalAlignment="Right" MinWidth="100" Margin="0,12,0,0"
            IsDefault="True" Click="Confirm_Click" />
  </Grid>

</Window>
