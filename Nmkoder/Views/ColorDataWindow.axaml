<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nmkoder.Views.ColorDataWindow"
        Title="Transfer Color Metadata"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <StackPanel Margin="16" Spacing="10">

    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Source Video" />
      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SourceVideo" Margin="0,0,0,6" />
      <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Target Video" />
      <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TargetVideo" />
    </Grid>

    <TextBlock Classes="h" Text="Data to transfer" />
    <CheckBox x:Name="CopyColorSpace" Content="Color space (transfer, primaries, matrix, range)" />
    <CheckBox x:Name="CopyHdrData" Content="HDR metadata (mastering display, MaxCLL/MaxFALL)" />

    <TextBlock x:Name="BatchNote" Classes="dim" IsVisible="False"
               Text="In Batch Processing Mode this utility can only read metadata. Switch to Muxing Mode to transfer it." />

    <Button Content="OK" HorizontalAlignment="Right" MinWidth="100" Margin="0,8,0,0"
            IsDefault="True" Click="Confirm_Click" />

  </StackPanel>

</Window>
