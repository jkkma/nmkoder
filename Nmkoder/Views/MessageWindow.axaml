<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nmkoder.Views.MessageWindow"
        Title="Nmkoder"
        Width="480" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <Grid RowDefinitions="*,Auto" Margin="16">
    <ScrollViewer Grid.Row="0" MaxHeight="480">
      <SelectableTextBlock x:Name="TextLabel" TextWrapping="Wrap" />
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="Btn3" Content="Yes" MinWidth="80" Click="Btn3_Click" />
      <Button x:Name="Btn2" Content="No" MinWidth="80" Click="Btn2_Click" />
      <Button x:Name="Btn1" Classes="accent" Content="OK" MinWidth="80" Click="Btn1_Click" IsDefault="True" />
    </StackPanel>
  </Grid>

</Window>
