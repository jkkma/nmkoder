<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="Nmkoder.Views.MainWindow"
        Title="NMKODER"
        Width="1360" Height="880" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource NmkoderBackground}">

  <!-- Work area on top, the log along the bottom, run controls in the footer. The log's row is
       the one the splitter drags and the one whose height is saved between sessions, and it is
       found through LogPanel's Grid.Row rather than by index, so inserting a row above it cannot
       quietly start resizing something else. -->
  <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto,220,Auto" Margin="10">

    <!-- ══════════════ Header ══════════════ -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="NMKODER" FontSize="20" FontWeight="Bold" LetterSpacing="1"
                   Foreground="{DynamicResource NmkoderHeaderText}" VerticalAlignment="Center" />
        <!-- Filled in from the assembly - the header is where a version is looked for, and it was
             not anywhere in the app before. -->
        <TextBlock x:Name="VersionLabel" Classes="dim" VerticalAlignment="Bottom" Margin="0,0,0,3" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Button Classes="subtle" Content="Discord" Click="Discord_Click" />
        <Button Classes="subtle" Content="Patreon" Click="Patreon_Click" />
        <Button Classes="subtle" Content="PayPal" Click="PayPal_Click" />
      </StackPanel>
    </Grid>

    <!-- ══════════════ Main area ══════════════ -->
    <!-- The tabs and their content share one rounded panel, raised off the window background. -->
    <Border Grid.Row="1" Classes="panel">
      <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">

        <!-- ─────────── File List ─────────── -->
        <TabItem Header="File List">
          <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto" Margin="8">
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8" Spacing="6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="field" Text="Mode" VerticalAlignment="Center" />
                <ComboBox x:Name="FileListModeBox" Classes="wide" SelectionChanged="FileListMode_SelectionChanged">
                  <ComboBoxItem Content="Muxing Mode - Merge all loaded files into one output" />
                  <ComboBoxItem Content="Batch Processing Mode - Run the task on each file separately" />
                </ComboBox>
              </StackPanel>

              <!-- Batch mode overwrites the output box once per file, so it is the only place the
                   user gets a say in what the twelve outputs are called. -->
              <StackPanel x:Name="BatchNamingPanel" Orientation="Horizontal" IsVisible="False">
                <TextBlock Classes="field" Text="Output Names" VerticalAlignment="Center" />
                <TextBox x:Name="BatchNameTemplateBox" Width="300" PlaceholderText="{}{name}"
                         TextChanged="BatchNameTemplate_TextChanged" />
                <!-- The button sits before the hint so that a long example clips against the window
                     edge rather than pushing the button off it. -->
                <Button x:Name="BatchNamingHelpBtn" Classes="icon" Content="?" Margin="6,0,0,0"
                        Click="BatchNamingHelp_Click" />
                <TextBlock x:Name="BatchNamingHintLabel" Classes="hint" VerticalAlignment="Center" Margin="10,0,0,0" />
              </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="0">
              <ListBox x:Name="FileListBox" SelectionMode="Multiple"
                       SelectionChanged="FileList_SelectionChanged" DoubleTapped="FileList_DoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <!-- The status glyph and text only appear once a batch has put the file in a
                         queue; outside one HasBatchStatus is false and the row is just its name. -->
                    <Border BorderBrush="{Binding RowBrush}" BorderThickness="4,0,0,0" Padding="6,2"
                            ToolTip.Tip="{Binding StatusTooltip}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"
                                   IsVisible="{Binding HasBatchStatus}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                   IsVisible="{Binding HasBatchStatus}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="12,0,0,0" FontSize="12" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Shown while the list is empty, so the drop target says what it is. Not hit-testable:
                   the list underneath still has to take the drop and the clicks. -->
              <StackPanel x:Name="FileListEmptyHint" IsHitTestVisible="False" Spacing="18"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- An open crate with an arrow dropping into it, drawn rather than bitmapped so it
                     stays sharp at whatever size the panel gives it. -->
                <Viewbox Width="150" Height="150" HorizontalAlignment="Center">
                  <Canvas Width="64" Height="64">
                    <Path Stroke="{DynamicResource NmkoderMutedText}" StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Data="M 10,34 L 32,26 L 54,34 L 32,42 Z
                                M 10,34 L 10,50 L 32,58 L 54,50 L 54,34
                                M 32,42 L 32,58
                                M 10,34 L 3,27 L 25,19 L 32,26
                                M 32,26 L 39,19 L 61,27 L 54,34
                                M 10,34 L 4,40 L 26,48 L 32,42
                                M 32,42 L 38,48 L 60,40 L 54,34
                                M 32,2 L 32,17
                                M 26,11 L 32,17 L 38,11" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Drag &amp; drop media files anywhere in this window to load them."
                           HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource NmkoderMutedText}" />
              </StackPanel>
            </Grid>

            <!-- Preview, fixed 16:9 so it keeps the shape of the footage it is showing. The
                 whole panel cycles thumbnails, not just the pixels the image happens to cover.
                 The Track List tab has the same panel; SetThumbnail() feeds both. -->
            <StackPanel Grid.Row="1" Grid.Column="1" Width="384" Margin="10,0,0,0" VerticalAlignment="Top">
              <Border Classes="card" Padding="0" Height="216" ClipToBounds="True" PointerPressed="Thumbnail_Click">
                <Image x:Name="ThumbnailBox" Stretch="Uniform" />
              </Border>
              <TextBlock x:Name="ThumbLabel" Classes="dim" Margin="2,6,2,0" />
            </StackPanel>

            <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <TextBlock Grid.Column="0" x:Name="FileCountLabel" Classes="dim" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="AddFilesBtn" Content="Add Files…" Click="AddFiles_Click" />
                <Button x:Name="AddFolderBtn" Content="Add Folder…" Click="AddFolder_Click" />
                <Button x:Name="FileListRecentBtn" Content="Recent…" Click="FileListRecent_Click" />
                <Button x:Name="AddTracksFromFileBtn" Content="Load Tracks" Click="AddTracksFromFile_Click" />
                <Button x:Name="FileListSortBtn" Content="Sort…" Click="FileListSort_Click" />
                <Button x:Name="FileListMoveUpBtn" Content="▲" Classes="icon" Click="FileListMoveUp_Click" />
                <Button x:Name="FileListMoveDownBtn" Content="▼" Classes="icon" Click="FileListMoveDown_Click" />
                <Button x:Name="FileListRemoveBtn" Content="Remove" Click="FileListRemove_Click" />
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>

        <!-- ─────────── Track List ─────────── -->
        <TabItem Header="Track List">
          <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="8">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="FormatInfoLabel" Classes="dim" Margin="0,0,0,6" />

            <Border Grid.Row="1" Grid.Column="0">
              <Grid>
                <ListBox x:Name="StreamListBox" SelectionChanged="StreamList_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{Binding RowBrush}" BorderThickness="4,0,0,0" Padding="6,2">
                        <!-- The name is deliberately not the CheckBox's content: clicking a track's
                             text selects it, and only the box itself ticks it. -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <!-- Covers the list in Batch Processing Mode, where track selection isn't available -->
                <Border x:Name="StreamListBlockPanel" IsVisible="False" Background="{DynamicResource NmkoderScrim}" CornerRadius="6">
                  <TextBlock Text="Track selection is not available while a batch is running."
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>

            <!-- Same preview as the File List tab, kept in step by SetThumbnail() -->
            <StackPanel Grid.Row="1" Grid.Column="1" Width="384" Margin="10,0,0,0" VerticalAlignment="Top">
              <Border Classes="card" Padding="0" Height="216" ClipToBounds="True" PointerPressed="Thumbnail_Click">
                <Image x:Name="TrackThumbnailBox" Stretch="Uniform" />
              </Border>
              <TextBlock x:Name="TrackThumbLabel" Classes="dim" Margin="2,6,2,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,8,0,0">
              <Button x:Name="TrackListCheckTracksBtn" Content="Select…" Click="TrackListCheckTracks_Click" />
              <Button x:Name="TrackListSortTracksBtn" Content="Sort…" Click="TrackListSortTracks_Click" />
              <Button x:Name="TrackListExtractTracksBtn" Content="Extract" IsVisible="False" Click="TrackListExtract_Click" />
              <Button x:Name="TrackListMoveUpBtn" Content="▲" Classes="icon" IsVisible="False" Click="TrackListMoveUp_Click" />
              <Button x:Name="TrackListMoveDownBtn" Content="▼" Classes="icon" IsVisible="False" Click="TrackListMoveDown_Click" />
            </StackPanel>

            <!-- Collapsed until a track is selected; see SetStreamDetails() -->
            <TextBox Grid.Row="3" Grid.ColumnSpan="2" x:Name="StreamDetailsBox" IsVisible="False"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Height="110" Margin="0,8,0,0" Classes="mono" />

            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Classes="field" Text="Default Audio" />
              <ComboBox x:Name="TrackListDefaultAudioBox" Width="260" Margin="0,0,32,0" />
              <TextBlock Classes="field" Text="Default Subtitles" />
              <ComboBox x:Name="TrackListDefaultSubsBox" Width="260" />
            </StackPanel>
          </Grid>
        </TabItem>

        <!-- ─────────── AV1AN ─────────── -->
        <TabItem Header="AV1AN">
          <Grid RowDefinitions="*,Auto" Margin="8">
            <TabControl Grid.Row="0" x:Name="Av1anTabs">

              <TabItem Header="Video">
                <ScrollViewer>
                  <Grid Classes="form" ColumnDefinitions="130,320,40,130,320,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Encoder" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Av1anCodecBox" SelectionChanged="Av1anCodec_SelectionChanged" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Container" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Av1anContainerBox" SelectionChanged="Av1anContainer_SelectionChanged" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Quality Mode" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Av1anQualModeBox" SelectionChanged="Av1anQualityMode_SelectionChanged" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Quality" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="Av1anQualityUpDown" Classes="num" Minimum="0" Maximum="100" Increment="1" Value="30" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="Preset / Effort" />
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="Av1anPresetBox" Classes="short" />

                    <TextBlock Grid.Row="0" Grid.Column="3" Classes="field" Text="Color Format" />
                    <ComboBox Grid.Row="0" Grid.Column="4" x:Name="Av1anColorSpaceBox" />

                    <TextBlock Grid.Row="1" Grid.Column="3" Classes="field" Text="Grain Synthesis" />
                    <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="10">
                      <NumericUpDown x:Name="Av1anGrainSynthStrengthUpDown" Classes="num" Minimum="0" Maximum="50" Increment="1" Value="0" />
                      <CheckBox x:Name="Av1anGrainSynthDenoiseBox" Content="Denoise" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="3" Classes="field" Text="Frame Rate" />
                    <TextBox Grid.Row="2" Grid.Column="4" x:Name="Av1anFpsBox" Classes="num" PlaceholderText="Keep original" />

                    <TextBlock Grid.Row="3" Grid.Column="3" Classes="field" Text="Resize" />
                    <!-- Spans into the filler column so the readout under the dropdown stays on one line:
                         at 320 wide it wraps, and it is rewritten on every file load, so a wrap would
                         reflow the rows beneath it each time a file is selected. -->
                    <StackPanel Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                        <ComboBox x:Name="Av1anResizeBox" Width="260" SelectionChanged="Av1anResize_SelectionChanged"
                                  ToolTip.Tip="Each target is a box the picture is fitted inside, so the source's aspect ratio is kept whatever it is. The size beside each one is what this file comes out as." />
                        <Button x:Name="Av1anResizeConfBtn" Content="Configure…" IsVisible="False" Click="Av1anResizeConf_Click" />
                      </StackPanel>
                      <TextBlock x:Name="Av1anResizeInfoLabel" Classes="hint" Text="" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="3" Classes="field" Text="Crop" />
                    <StackPanel Grid.Row="4" Grid.Column="4" Orientation="Horizontal" Spacing="6">
                      <ComboBox x:Name="Av1anCropBox" Width="260" SelectionChanged="Av1anCrop_SelectionChanged">
                        <ComboBoxItem Content="Disabled" />
                        <ComboBoxItem Content="Automatic (detect black bars)" />
                        <ComboBoxItem Content="Manual" />
                      </ComboBox>
                      <Button x:Name="Av1anCropConfBtn" Content="Configure…" IsVisible="False" Click="Av1anCropConf_Click" />
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="3" Classes="field" Text="Borders" />
                    <!-- Spans into the filler column for the readout underneath, as the Resize row does. -->
                    <StackPanel Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="2" Spacing="4">
                      <ComboBox x:Name="Av1anBordersBox" Width="260" HorizontalAlignment="Left" SelectionChanged="Av1anBorders_SelectionChanged"
                                ToolTip.Tip="Adds black bars around the picture until the frame is the shape you pick, without scaling anything. Which bars are needed is worked out per file: a 2.39:1 film is wider than 16:9 and gets them along the top and bottom, a 4:3 capture is narrower and gets them down the sides, and a source already that shape gets none. The bars go on after the crop and the resize, so they are added to the finished picture rather than scaled along with it." />
                      <TextBlock x:Name="Av1anBordersInfoLabel" Classes="hint" Text="" />
                    </StackPanel>

                    <TextBlock Grid.Row="6" Grid.Column="3" Classes="field" Text="Trim" />
                    <StackPanel Grid.Row="6" Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                      <!-- Capped so the button beside it stays inside this 320 wide column: a horizontal
                           StackPanel measures its children with no width limit, where the Grid cell the
                           button used to sit in directly imposed one. 320 - the Clear button (67) - the gap (6). -->
                      <Button x:Name="Av1anTrimConfBtn" Content="Configure…" MaxWidth="247" Click="Av1anTrimConf_Click" />
                      <Button x:Name="Av1anTrimClearBtn" Content="Clear" IsVisible="False" Click="Av1anTrimClear_Click"
                              ToolTip.Tip="Remove the configured trim, so the whole video is encoded." />
                    </StackPanel>

                    <!-- Both halves of the row are hidden together, and only shown once the loaded file
                         is known to be interlaced - see DeinterlaceUi.RefreshInfo. -->
                    <TextBlock Grid.Row="7" Grid.Column="3" x:Name="Av1anDeintLabel" Classes="field" Text="Deinterlace" IsVisible="False" />
                    <!-- Spans into the filler column for the readout underneath, as the Resize row does. -->
                    <StackPanel Grid.Row="7" Grid.Column="4" Grid.ColumnSpan="2" x:Name="Av1anDeintPanel" Spacing="4" IsVisible="False">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                        <ComboBox x:Name="Av1anDeintModeBox" Width="200" SelectionChanged="Av1anDeintMode_SelectionChanged"
                                  ToolTip.Tip="Automatic only does something when the source really is interlaced, which a tape or DVD capture is and a modern download is not, and it uses bwdif. QTGMC is the motion-compensated deinterlacer - far better, and far slower. av1an cannot run it on its own (it filters each chunk with ffmpeg, which cannot evaluate a VapourSynth script), so picking it here renders the whole file through QTGMC into a near-lossless intermediate first and encodes that. Expect a long extra pass and a large temporary file. It falls back to bwdif where VapourSynth cannot run it." />
                        <ComboBox x:Name="Av1anDeintPresetBox" Width="125" SelectionChanged="Av1anDeintPreset_SelectionChanged"
                                  ToolTip.Tip="QTGMC's own speed setting. Its documented default is Slower; Very Slow is the default here, which also turns on QTGMC's noise processing. It is the slowest setting worth using and the sources this runs on are usually hour-long captures, so expect the pass to take a while." />
                        <CheckBox x:Name="Av1anDeintDoubleRateBox" Content="One frame per field" IsChecked="True" IsCheckedChanged="Av1anDeintRate_Changed"
                                  ToolTip.Tip="The two fields of an interlaced frame were shot at different moments, so keeping both doubles the frame rate and preserves all of the motion. Only offered for QTGMC: it runs before av1an, so the doubled rate is simply the rate of the file av1an is given, where a filter inside av1an emitting one frame per field would write twice the frames its chunking expects." />
                      </StackPanel>
                      <TextBlock x:Name="Av1anDeintInfoLabel" Classes="hint" Text="" />
                    </StackPanel>
                  </Grid>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Audio &amp; Tracks">
                <Grid Classes="form" ColumnDefinitions="130,320,*" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Codec" />
                  <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Av1anAudCodecBox" SelectionChanged="Av1anAudCodec_SelectionChanged" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Bitrate (Kbps)" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="Av1anAudQualUpDown" Classes="num" Minimum="0" Maximum="8192" Increment="8" Value="128" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Channels" />
                  <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Av1anAudChannelsBox" Width="230" HorizontalAlignment="Left">
                    <ComboBoxItem Content="0 (Keep original)" />
                    <ComboBoxItem Content="2 (Stereo)" />
                    <ComboBoxItem Content="6 (5.1 Surround)" />
                    <ComboBoxItem Content="8 (7.1 Surround)" />
                  </ComboBox>

                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Also Copy" />
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <CheckBox x:Name="CheckAv1anCopySubs" Content="Subtitles" IsChecked="True" />
                    <CheckBox x:Name="CheckAv1anCopyData" Content="Data Tracks" />
                    <CheckBox x:Name="CheckAv1anCopyAttachs" Content="Attachments" IsChecked="True" />
                  </StackPanel>
                </Grid>
              </TabItem>

              <TabItem Header="Av1an Options">
                <ScrollViewer>
                  <Grid Classes="form" ColumnDefinitions="150,320,40,170,320,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Split Method" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Av1anOptsSplitModeBox" SelectionChanged="Av1anOption_SelectionChanged">
                      <ComboBoxItem Content="None" />
                      <ComboBoxItem Content="Scene Change Detection" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Chunk Method" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Av1anOptsChunkModeBox" SelectionChanged="Av1anOption_SelectionChanged" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Concat Method" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Av1anOptsConcatModeBox" SelectionChanged="Av1anOption_SelectionChanged">
                      <ComboBoxItem Content="MKVMerge" />
                      <ComboBoxItem Content="FFmpeg" />
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Chunk Order" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="Av1anOptsChunkOrderBox" SelectionChanged="Av1anOption_SelectionChanged">
                      <ComboBoxItem Content="Long-to-Short (Best CPU utilization)" />
                      <ComboBoxItem Content="Short-to-Long (Not very useful)" />
                      <ComboBoxItem Content="Sequential (Same order as input video)" />
                      <ComboBoxItem Content="Random (Most accurate filesize estimation)" />
                    </ComboBox>

                    <TextBlock Grid.Row="0" Grid.Column="3" Classes="field" Text="Workers" />
                    <NumericUpDown Grid.Row="0" Grid.Column="4" x:Name="Av1anOptsWorkerCountUpDown" Classes="num" Minimum="1" Maximum="64" Increment="1" Value="4" ValueChanged="Av1anWorkerCount_ValueChanged"
                                   ToolTip.Tip="How many chunks av1an encodes at the same time.&#10;&#10;SVT-AV1 runs two fewer than the other encoders: it works a core much harder than they do, so the count that keeps them busy oversubscribes the machine on it and every worker ends up slower. Selecting another encoder puts them back.&#10;&#10;Changing this sets the count for the encoder selected, and the gap is kept for the others." />

                    <TextBlock Grid.Row="1" Grid.Column="3" Classes="field" Text="Threads per Worker" />
                    <NumericUpDown Grid.Row="1" Grid.Column="4" x:Name="Av1anThreadsUpDown" Classes="num" Minimum="1" Maximum="64" Increment="1" Value="2" ValueChanged="Av1anOption_ValueChanged" />

                    <TextBlock Grid.Row="2" Grid.Column="3" Classes="field" Text="Custom av1an Args" />
                    <TextBox Grid.Row="2" Grid.Column="4" x:Name="Av1anCustomArgsBox" />

                    <TextBlock Grid.Row="3" Grid.Column="3" Classes="field" Text="Custom Encoder Args" />
                    <TextBox Grid.Row="3" Grid.Column="4" x:Name="Av1anCustomEncArgsBox" />
                  </Grid>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Advanced">
                <!-- The argument list is the long one, so it takes every row the tab can spare and
                     the filters below size to their own content. -->
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="4">
                  <!-- The right-click window is the only place the long explanations live, and nothing
                       else on screen would say so, so the heading carries the hint. -->
                  <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Classes="h" Text="ENCODER ARGUMENTS" VerticalAlignment="Center" Margin="0" />
                    <TextBlock Grid.Column="1" Classes="hint" Margin="12,0,0,0"
                               Text="Right-click an argument for a full explanation and example values." />
                  </Grid>
                  <!-- The preset buttons are built in code (LoadAv1anArgPresets), one per preset defined
                       for the selected encoder, so the whole row is hidden for encoders that have none. -->
                  <StackPanel Grid.Row="1" x:Name="Av1anArgPresetPanel" Orientation="Horizontal" Spacing="6"
                              Margin="0,0,0,6" IsVisible="False">
                    <TextBlock Classes="field" Text="Presets" VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- One tab per argument category. The tabs and their grids are built in code
                       (LoadAv1anArgCategoryTabs) because every encoder has its own categories. -->
                  <TabControl Grid.Row="2" x:Name="Av1anArgCategoryTabs" />

                  <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,4">
                    <TextBlock Grid.Column="0" Classes="h" Text="CUSTOM VIDEO FILTERS" VerticalAlignment="Center" Margin="0" />
                    <Button Grid.Column="1" Content="Add" Margin="0,0,6,0" Click="Av1anFilterAdd_Click" />
                    <Button Grid.Column="2" Content="Remove" Click="Av1anFilterRemove_Click" />
                  </Grid>

                  <dg:DataGrid Grid.Row="4" x:Name="Av1anAdvancedFiltersGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                               MaxHeight="180" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <dg:DataGrid.Columns>
                      <dg:DataGridTextColumn Header="Filter" Binding="{Binding Filter}" Width="*" />
                    </dg:DataGrid.Columns>
                  </dg:DataGrid>
                </Grid>
              </TabItem>

            </TabControl>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
              <TextBlock Grid.Column="0" Classes="field" Text="Output Path" />
              <TextBox Grid.Column="1" x:Name="Av1anOutputPathBox" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                <Button Content="…" Classes="icon" Click="BrowseAv1anOutput_Click" />
                <Button x:Name="Av1anResumeBtn" Content="Resume…" Click="Av1anResume_Click" />
                <Button x:Name="Av1anClearTempBtn" Content="Clear Temp…" Click="Av1anClearTemp_Click"
                        ToolTip.Tip="Delete the temporary files of every unfinished encode. They cannot be resumed afterwards." />
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>

        <!-- ─────────── Quick Convert ─────────── -->
        <TabItem Header="Quick Convert">
          <Grid RowDefinitions="*,Auto" Margin="8">
            <TabControl Grid.Row="0" x:Name="QuickEncTabs">

              <TabItem Header="Video">
                <ScrollViewer>
                  <Grid Classes="form" ColumnDefinitions="130,320,40,130,320,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Codec" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="EncVidCodecsBox" SelectionChanged="EncVidCodec_SelectionChanged" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Container" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FfmpegContainerBox" SelectionChanged="Container_SelectionChanged" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Quality Mode" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EncQualModeBox" SelectionChanged="EncQualityMode_SelectionChanged" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Quality" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <NumericUpDown x:Name="EncVidQualityBox" Classes="num" Minimum="0" Maximum="100" Increment="1" Value="20" />
                      <TextBlock x:Name="QInfoLabel" Classes="hint" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="Preset / Effort" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <ComboBox x:Name="EncVidPresetBox" Classes="short" />
                      <TextBlock x:Name="PresetInfoLabel" Classes="hint" />
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="3" Classes="field" Text="Color Format" />
                    <ComboBox Grid.Row="0" Grid.Column="4" x:Name="EncVidColorsBox" />

                    <TextBlock Grid.Row="1" Grid.Column="3" Classes="field" Text="Frame Rate" />
                    <TextBox Grid.Row="1" Grid.Column="4" x:Name="EncVidFpsBox" Classes="num" PlaceholderText="Keep original" />

                    <TextBlock Grid.Row="2" Grid.Column="3" Classes="field" Text="Resize (W x H)" />
                    <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" Spacing="6">
                      <!-- TextChanged only feeds the Borders readout under the row below, which names
                           the frame the bars go around; these boxes are still saved on close. -->
                      <TextBox x:Name="EncScaleBoxW" Classes="num" PlaceholderText="Auto" TextChanged="EncScaleBox_TextChanged" />
                      <TextBlock Text="x" VerticalAlignment="Center" />
                      <TextBox x:Name="EncScaleBoxH" Classes="num" PlaceholderText="Auto" TextChanged="EncScaleBox_TextChanged" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="3" Classes="field" Text="Crop" />
                    <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Horizontal" Spacing="6">
                      <ComboBox x:Name="EncCropModeBox" Width="260" SelectionChanged="EncCropMode_SelectionChanged">
                        <ComboBoxItem Content="Disabled" />
                        <ComboBoxItem Content="Automatic (detect black bars)" />
                        <ComboBoxItem Content="Manual" />
                      </ComboBox>
                      <Button x:Name="EncCropConfBtn" Content="Configure…" IsVisible="False" Click="EncCropConf_Click" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="3" Classes="field" Text="Borders" />
                    <!-- Spans into the filler column for the readout underneath, as the AV1AN tab's does. -->
                    <StackPanel Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="2" Spacing="4">
                      <ComboBox x:Name="EncBordersBox" Width="260" HorizontalAlignment="Left" SelectionChanged="EncBorders_SelectionChanged"
                                ToolTip.Tip="Adds black bars around the picture until the frame is the shape you pick, without scaling anything. Which bars are needed is worked out per file: a 2.39:1 film is wider than 16:9 and gets them along the top and bottom, a 4:3 capture is narrower and gets them down the sides, and a source already that shape gets none. The bars go on after the crop and the resize, so they are added to the finished picture rather than scaled along with it." />
                      <TextBlock x:Name="EncBordersInfoLabel" Classes="hint" Text="" />
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="3" Classes="field" Text="Trim" />
                    <StackPanel Grid.Row="5" Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                      <!-- Capped to keep the button beside it inside this 320 wide column, as on the AV1AN tab -->
                      <Button x:Name="EncTrimConfBtn" Content="Configure…" MaxWidth="247" Click="EncTrimConf_Click" />
                      <Button x:Name="EncTrimClearBtn" Content="Clear" IsVisible="False" Click="EncTrimClear_Click"
                              ToolTip.Tip="Remove the configured trim, so the whole video is encoded." />
                    </StackPanel>

                    <!-- Both halves of the row are hidden together, and only shown once the loaded file
                         is known to be interlaced - see DeinterlaceUi.RefreshInfo. -->
                    <TextBlock Grid.Row="6" Grid.Column="3" x:Name="EncDeintLabel" Classes="field" Text="Deinterlace" IsVisible="False" />
                    <!-- Spans into the filler column, as the AV1AN tab's Resize row does: the readout
                         under it is rewritten on every file load and must not wrap. -->
                    <StackPanel Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="2" x:Name="EncDeintPanel" Spacing="4" IsVisible="False">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                        <ComboBox x:Name="EncDeintModeBox" Width="200" SelectionChanged="EncDeintMode_SelectionChanged"
                                  ToolTip.Tip="Automatic only does something when the source really is interlaced, which a tape or DVD capture is and a modern download is not. QTGMC is a motion-compensated deinterlacer run through VapourSynth - far better than bwdif or yadif, and far slower; it falls back to bwdif where VapourSynth cannot run it." />
                        <ComboBox x:Name="EncDeintPresetBox" Width="125" SelectionChanged="EncDeintPreset_SelectionChanged"
                                  ToolTip.Tip="QTGMC's own speed setting. Its documented default is Slower; Very Slow is the default here, which also turns on QTGMC's noise processing. It is the slowest setting worth using and the sources this runs on are usually hour-long captures, so expect the pass to take a while." />
                        <CheckBox x:Name="EncDeintDoubleRateBox" Content="One frame per field" IsChecked="True" IsCheckedChanged="EncDeintRate_Changed"
                                  ToolTip.Tip="The two fields of an interlaced frame were shot at different moments, so keeping both doubles the frame rate and preserves all of the motion. Untick to get one frame out per source frame instead." />
                      </StackPanel>
                      <TextBlock x:Name="EncDeintInfoLabel" Classes="hint" Text="" />
                    </StackPanel>
                  </Grid>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Audio">
                <Grid Classes="form" ColumnDefinitions="130,320,*" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Codec" />
                  <ComboBox Grid.Row="0" Grid.Column="1" x:Name="EncAudCodecBox" SelectionChanged="EncAudCodec_SelectionChanged" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Configuration" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <ComboBox x:Name="EncAudConfModeBox" Width="270" SelectionChanged="EncAudConfMode_SelectionChanged">
                      <ComboBoxItem Content="Same settings for all tracks" />
                      <ComboBoxItem Content="Configure each track separately" />
                    </ComboBox>
                    <Button x:Name="EncAudConfigureBtn" Content="Configure…" IsVisible="False" Click="EncAudConfigure_Click" />
                  </StackPanel>

                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Bitrate (Kbps)" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="EncAudQualUpDown" Classes="num" Minimum="0" Maximum="8192" Increment="8" Value="128" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Channels" />
                  <ComboBox Grid.Row="3" Grid.Column="1" x:Name="EncAudChannelsBox" Width="230" HorizontalAlignment="Left">
                    <ComboBoxItem Content="0 (Keep original)" />
                    <ComboBoxItem Content="1 (Mono)" />
                    <ComboBoxItem Content="2 (Stereo)" />
                    <ComboBoxItem Content="6 (5.1 Surround)" />
                    <ComboBoxItem Content="8 (7.1 Surround)" />
                  </ComboBox>
                </Grid>
              </TabItem>

              <TabItem Header="Subtitles">
                <Grid Classes="form" ColumnDefinitions="130,320,*" RowDefinitions="Auto,Auto,*" Margin="4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Codec" />
                  <ComboBox Grid.Row="0" Grid.Column="1" x:Name="EncSubCodecBox" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Burn In" />
                  <ComboBox Grid.Row="1" Grid.Column="1" x:Name="EncSubBurnBox" />
                </Grid>
              </TabItem>

              <TabItem Header="Metadata">
                <Grid RowDefinitions="Auto,Auto,*" Margin="4">
                  <Grid Classes="form" Grid.Row="0" ColumnDefinitions="150,320,40,150,320,*">
                    <TextBlock Grid.Column="0" Classes="field" Text="Copy Metadata From" />
                    <ComboBox Grid.Column="1" x:Name="EncMetaCopySource" />
                    <TextBlock Grid.Column="3" Classes="field" Text="Copy Chapters From" />
                    <ComboBox Grid.Column="4" x:Name="EncMetaChapterSource" />
                  </Grid>

                  <CheckBox Grid.Row="1" x:Name="EncMetaApplyGrid" Content="Apply the titles and languages below" IsChecked="True" Margin="0,8,0,6" />

                  <dg:DataGrid Grid.Row="2" x:Name="EncMetadataGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                               GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <dg:DataGrid.Columns>
                      <dg:DataGridTextColumn Header="Track" Binding="{Binding Field}" IsReadOnly="True" Width="2*" />
                      <dg:DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="5*" />
                      <dg:DataGridTextColumn Header="Lang" Binding="{Binding Language}" Width="Auto" MinWidth="80" />
                    </dg:DataGrid.Columns>
                  </dg:DataGrid>
                </Grid>
              </TabItem>

              <TabItem Header="Advanced">
                <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="4">
                  <TextBlock Grid.Row="0" Classes="h" Text="CUSTOM ARGUMENTS" Margin="0,0,0,4" />
                  <Grid Classes="form" Grid.Row="1" ColumnDefinitions="130,640,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Input Args" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="EncCustomArgsIn" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Output Args" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="EncCustomArgsOut" />
                  </Grid>

                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,4">
                    <TextBlock Grid.Column="0" Classes="h" Text="CUSTOM VIDEO FILTERS" VerticalAlignment="Center" Margin="0" />
                    <Button Grid.Column="1" Content="Add" Margin="0,0,6,0" Click="EncFilterAdd_Click" />
                    <Button Grid.Column="2" Content="Remove" Click="EncFilterRemove_Click" />
                  </Grid>

                  <dg:DataGrid Grid.Row="3" x:Name="EncAdvancedFiltersGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                               GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <dg:DataGrid.Columns>
                      <dg:DataGridTextColumn Header="Filter" Binding="{Binding Filter}" Width="*" />
                    </dg:DataGrid.Columns>
                  </dg:DataGrid>
                </Grid>
              </TabItem>

            </TabControl>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
              <TextBlock Grid.Column="0" Classes="field" Text="Output Path" />
              <TextBox Grid.Column="1" x:Name="OutputPathBox" />
              <Button Grid.Column="2" Content="…" Classes="icon" Margin="6,0,0,0" Click="BrowseFfmpegOutput_Click" />
            </Grid>
          </Grid>
        </TabItem>

        <!-- ─────────── Utilities ─────────── -->
        <TabItem Header="Utilities">
          <ScrollViewer>
            <!-- A WrapPanel rather than a column: eight cards stacked one per row ran off the
                 bottom of the tab with most of the width sitting empty beside them. Fixed-width
                 cards wrap into as many columns as the window allows - three at the default size,
                 two at the minimum - and each row is only as tall as its own tallest card, which a
                 UniformGrid could not do without padding every card out to the longest one. -->
            <StackPanel Margin="8" Spacing="8">
              <TextBlock Classes="dim" Text="Pick a utility, then press Run. Utilities are shortcuts for actions that normally need long CLI commands." />

              <WrapPanel>
                <Border x:Name="UtilsBitratesPanel" Classes="card util" Tapped="SelectReadBitrates">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                      <TextBlock Text="Read Bitrates" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Calculates stream size and average bitrate for each selected track." />
                  </StackPanel>
                </Border>

                <Border x:Name="UtilsMetricsPanel" Classes="card util" Tapped="SelectGetMetrics">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                      <TextBlock Grid.Column="0" Text="Get Metrics" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Configure…" Click="UtilsMetricsConf_Click" />
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Calculate quality metrics like VMAF, SSIM and PSNR between two loaded files." />
                  </StackPanel>
                </Border>

                <Border x:Name="UtilsColorDataPanel" Classes="card util" Tapped="SelectColorData">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                      <TextBlock Grid.Column="0" Text="Transfer Color Metadata" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Configure…" Click="UtilsColorDataConf_Click" />
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Copy color properties and HDR metadata from one file to another." />
                  </StackPanel>
                </Border>

                <Border x:Name="UtilsDeinterlacePanel" Classes="card util" Tapped="SelectDeinterlace"
                        ToolTip.Tip="Writes a deinterlaced file and stops there - nothing is loaded back into the file list. You do not need this to encode an interlaced source: both encode tabs deinterlace on their way through, QTGMC included. Use it when the deinterlaced file is what you are after, or to look at one before committing to a long encode.">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                      <TextBlock Grid.Column="0" Text="Deinterlace Video" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" x:Name="UtilsDeinterlaceConfBtn" Content="Configure…" Click="UtilsDeinterlaceConf_Click" />
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Exports a deinterlaced copy - QTGMC over the whole file into a near-lossless MKV, audio and subtitles copied across. Has its own settings, separate from the encode tabs." />
                  </StackPanel>
                </Border>

                <Border x:Name="UtilsCutPanel" Classes="card util" Tapped="SelectCut"
                        ToolTip.Tip="Writes the section to a new file and stops there - nothing is loaded back into the file list. To encode part of a video rather than export it, use the Trim setting on the encode tab you are encoding from; this utility's section is its own and does not reach them.">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                      <TextBlock Grid.Column="0" Text="Cut Video" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" x:Name="UtilsCutConfBtn" Content="Configure…" Click="UtilsCutConf_Click" />
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Keep only a chosen section of the video, copied out without re-encoding. Pick the start and end point while watching the frame you are on." />
                  </StackPanel>
                </Border>

                <Border x:Name="UtilsConcatPanel" Classes="card util" Tapped="SelectConcat">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                      <TextBlock Text="Concatenate Into Single MKV" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Merge all loaded files into a single MKV without re-encoding." />
                  </StackPanel>
                </Border>

                <Border x:Name="UtilsBitratePlotPanel" Classes="card util" Tapped="SelectBitratePlot">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                      <TextBlock Text="Show Bitrate Chart" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Samples the bitrate across the whole video and plots it." />
                  </StackPanel>
                </Border>

                <Border x:Name="UtilsOcrPanel" Classes="card util" Tapped="SelectOcr">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                      <TextBlock Text="OCR Bitmap Subtitles" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="dim" TextWrapping="Wrap" Text="Converts selected bitmap-based subtitle tracks into text subtitles." />
                  </StackPanel>
                </Border>
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ─────────── Settings ─────────── -->
        <TabItem Header="Settings">
          <ScrollViewer>
            <StackPanel Margin="8" Spacing="6" MaxWidth="800" HorizontalAlignment="Left">
              <TextBlock Classes="h" Text="GENERAL" Margin="0,0,0,2" />

              <Grid Classes="form" ColumnDefinitions="200,320,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Console window" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmdDebugModeBox" SelectionChanged="CmdDebugMode_SelectionChanged">
                  <ComboBoxItem Content="Hidden (Default)" />
                  <ComboBoxItem Content="Visible" />
                  <ComboBoxItem Content="Visible, stays open after finishing" />
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Auto-crop samples" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="AutoCropSamplesUpDown" Classes="num" Minimum="1" Maximum="100" Increment="1" Value="10" ValueChanged="GeneralSetting_ValueChanged" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Keyframe interval (s)" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="KeyIntSecsUpDown" Classes="num" Minimum="1" Maximum="120" Increment="1" Value="10" ValueChanged="GeneralSetting_ValueChanged" />

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Save encodes to" />
                <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Left">
                  <TextBox Grid.Column="0" x:Name="DefaultOutDirBox" Width="430" LostFocus="DefaultOutDir_Changed"
                           PlaceholderText="Leave empty to save next to the source file" />
                  <Button Grid.Column="1" Content="…" Classes="icon" Margin="6,0,0,0" Click="BrowseDefaultOutDir_Click" />
                  <Button Grid.Column="2" Content="Clear" Margin="6,0,0,0" Click="ClearDefaultOutDir_Click" />
                </Grid>
              </Grid>

              <CheckBox x:Name="UseZeroIndexedStreamsBox" Content="Show stream numbers zero-indexed (like ffmpeg does)" IsCheckedChanged="GeneralSetting_Changed" />
              <CheckBox x:Name="Mp4FaststartBox" Content="Web-optimize MP4 output (+faststart)" IsChecked="True" IsCheckedChanged="GeneralSetting_Changed" />
              <CheckBox x:Name="Av1anCmdVisibleBox" Content="Show the av1an console window" IsChecked="True" IsCheckedChanged="GeneralSetting_Changed" />

              <TextBlock Classes="h" Text="RESET ON NEW FILE" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="field" Text="Settings to reset" Width="200" />
                <TextBlock x:Name="SettingsToResetLabel" VerticalAlignment="Center" Text="None" MinWidth="200" />
                <Button Content="Configure…" Click="ResetSettingsConf_Click" />
                <Button Content="Reset Now" Click="ResetSettingsResetAll_Click" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>
    </Border>

    <!-- ══════════════ Log divider ══════════════ -->
    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                  ToolTip.Tip="Drag to resize the log" />

    <!-- ══════════════ Log ══════════════ -->
    <Grid Grid.Row="3" x:Name="LogPanel" RowDefinitions="Auto,*">
      <!-- The controls share the header row rather than taking one of their own: the log's minimum
           height is 60px and a second row would spend most of it. -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
        <TextBlock Grid.Column="0" Classes="h" Text="LOG" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" x:Name="LogPausedLabel" Classes="hint" IsVisible="False" Margin="10,0,0,0"
                   VerticalAlignment="Center" Text="Scrolled up - new lines are not being followed. Scroll to the bottom to resume." />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button x:Name="LogCopyBtn" Classes="logbtn" Content="Copy" Click="LogCopy_Click"
                  ToolTip.Tip="Copy the whole log to the clipboard." />
          <Button x:Name="LogSaveBtn" Classes="logbtn" Content="Save…" Click="LogSave_Click"
                  ToolTip.Tip="Write the log to a text file." />
          <Button x:Name="LogFolderBtn" Classes="logbtn" Content="Log Folder" Click="LogFolder_Click"
                  ToolTip.Tip="Open this session's log folder, which also holds the per-tool logs (ffmpeg, av1an, mkvmerge)." />
          <Button x:Name="LogClearBtn" Classes="logbtn" Content="Clear" Click="LogClear_Click"
                  ToolTip.Tip="Empty the box. The session log on disk keeps everything." />
        </StackPanel>
      </Grid>

      <!-- A virtualizing list rather than one text control: severity needs per-line colour, and a
           TextBlock relays out every line it holds whenever one of them changes - at ten thousand
           lines that is seconds per scroll step, against milliseconds here.
           What virtualization costs is dragging a text selection ACROSS lines: each row owns its own
           SelectableTextBlock and Avalonia has no cross-control selection. Whole rows are selectable
           instead, which covers the same ground - but SelectableTextBlock takes the pointer press and
           the keys for its own use, so both are claimed on the tunnelling route in MainWindow.Log.cs
           before it sees them, and deliberately not marked handled, so dragging still selects text
           within a line. -->
      <ListBox Grid.Row="1" x:Name="LogBox" Classes="log" SelectionMode="Multiple"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <SelectableTextBlock Classes="logline" Classes.err="{Binding IsError}" Classes.warn="{Binding IsWarning}"
                                 Classes.dim="{Binding IsDim}" Text="{Binding Display}" TextWrapping="NoWrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- ══════════════ Footer: progress + run controls ══════════════ -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="CurrentActionLabel" Classes="dim" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="ProgBar" Minimum="0" Maximum="100" Height="8" Margin="0,4,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
        <CheckBox x:Name="ShutdownWhenDoneBox" Content="Shutdown when done" IsCheckedChanged="ShutdownWhenDone_Changed"
                  ToolTip.Tip="Shut the computer down 60 seconds after the running task or batch finishes, with the countdown shown here - untick to abort it. A canceled task does not shut down. Armed for this session only, never saved." />
        <Button x:Name="PauseBtn" Content="Pause" IsVisible="False" Click="Pause_Click" />
        <Button x:Name="StopBtn" Classes="danger" Content="Stop" IsVisible="False" Click="Stop_Click" />
        <Button x:Name="RunBtn" Classes="accent" Content="Run" MinWidth="120" FontWeight="SemiBold" Click="Run_Click" />
      </StackPanel>
    </Grid>

  </Grid>

</Window>
