<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="Nmkoder.Views.MainWindow"
        Title="NMKODER"
        Width="1360" Height="860" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource NmkoderBackground}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="10">

    <!-- ══════════════ Header ══════════════ -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="NMKODER" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="TitleHintLabel" Classes="dim" VerticalAlignment="Center" Margin="12,0"
                 Text="Drag &amp; drop media files anywhere in this window to load them." />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Button Content="Discord" Click="Discord_Click" />
        <Button Content="Patreon" Click="Patreon_Click" />
        <Button Content="PayPal" Click="PayPal_Click" />
      </StackPanel>
    </Grid>

    <!-- ══════════════ Main area ══════════════ -->
    <Grid Grid.Row="1" ColumnDefinitions="*,8,360">

      <TabControl Grid.Column="0" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">

        <!-- ─────────── File List ─────────── -->
        <TabItem Header="File List">
          <Grid RowDefinitions="Auto,*,Auto" Margin="8">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" Classes="field" Text="Mode" />
              <ComboBox Grid.Column="1" x:Name="FileListModeBox" SelectionChanged="FileListMode_SelectionChanged">
                <ComboBoxItem Content="Muxing Mode - Merge all loaded files into one output" />
                <ComboBoxItem Content="Batch Processing Mode - Run the task on each file separately" />
              </ComboBox>
            </Grid>

            <ListBox Grid.Row="1" x:Name="FileListBox" SelectionMode="Multiple"
                     SelectionChanged="FileList_SelectionChanged" DoubleTapped="FileList_DoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{Binding RowBrush}" BorderThickness="4,0,0,0" Padding="6,2">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <TextBlock Grid.Column="0" x:Name="FileCountLabel" Classes="dim" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="AddFilesBtn" Content="Add Files…" Click="AddFiles_Click" />
                <Button x:Name="AddFolderBtn" Content="Add Folder…" Click="AddFolder_Click" />
                <Button x:Name="AddTracksFromFileBtn" Content="Load Tracks" Click="AddTracksFromFile_Click" />
                <Button x:Name="FileListSortBtn" Content="Sort…" Click="FileListSort_Click" />
                <Button x:Name="FileListMoveUpBtn" Content="▲" Classes="icon" Click="FileListMoveUp_Click" />
                <Button x:Name="FileListMoveDownBtn" Content="▼" Classes="icon" Click="FileListMoveDown_Click" />
                <Button x:Name="FileListRemoveBtn" Content="Remove" Click="FileListRemove_Click" />
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>

        <!-- ─────────── Track List ─────────── -->
        <TabItem Header="Track List">
          <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="8">
            <TextBlock Grid.Row="0" x:Name="FormatInfoLabel" Classes="dim" Margin="0,0,0,6" />

            <Border Grid.Row="1">
              <Grid>
                <ListBox x:Name="StreamListBox" SelectionChanged="StreamList_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{Binding RowBrush}" BorderThickness="4,0,0,0" Padding="6,2">
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding DisplayName}" />
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <!-- Covers the list in Batch Processing Mode, where track selection isn't available -->
                <Border x:Name="StreamListBlockPanel" IsVisible="False" Background="#CC1B1B1B">
                  <TextBlock Text="Track selection is not available while a batch is running."
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,8,0,0">
              <Button x:Name="TrackListCheckTracksBtn" Content="Select…" Click="TrackListCheckTracks_Click" />
              <Button x:Name="TrackListSortTracksBtn" Content="Sort…" Click="TrackListSortTracks_Click" />
              <Button x:Name="TrackListExtractTracksBtn" Content="Extract" IsVisible="False" Click="TrackListExtract_Click" />
              <Button x:Name="TrackListMoveUpBtn" Content="▲" Classes="icon" IsVisible="False" Click="TrackListMoveUp_Click" />
              <Button x:Name="TrackListMoveDownBtn" Content="▼" Classes="icon" IsVisible="False" Click="TrackListMoveDown_Click" />
            </StackPanel>

            <TextBox Grid.Row="3" x:Name="StreamDetailsBox" IsReadOnly="True" AcceptsReturn="True"
                     Height="120" Margin="0,8,0,0" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" />

            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,*" Margin="0,8,0,0">
              <TextBlock Grid.Column="0" Classes="field" Text="Default Audio" />
              <ComboBox Grid.Column="1" x:Name="TrackListDefaultAudioBox" Margin="0,0,12,0" />
              <TextBlock Grid.Column="2" Classes="field" Text="Default Subtitles" />
              <ComboBox Grid.Column="3" x:Name="TrackListDefaultSubsBox" />
            </Grid>
          </Grid>
        </TabItem>

        <!-- ─────────── Quick Convert ─────────── -->
        <TabItem Header="Quick Convert">
          <Grid RowDefinitions="*,Auto" Margin="8">
            <TabControl Grid.Row="0" x:Name="QuickEncTabs">

              <TabItem Header="Video">
                <ScrollViewer>
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Codec" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="EncVidCodecsBox" Margin="0,0,0,6" SelectionChanged="EncVidCodec_SelectionChanged" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Container" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FfmpegContainerBox" Margin="0,0,0,6" SelectionChanged="Container_SelectionChanged" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Quality Mode" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EncQualModeBox" Margin="0,0,0,6" SelectionChanged="EncQualityMode_SelectionChanged" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Quality" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                      <NumericUpDown x:Name="EncVidQualityBox" Minimum="0" Maximum="100" Increment="1" Value="20" />
                      <TextBlock x:Name="QInfoLabel" Classes="dim" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="Preset / Effort" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,6">
                      <ComboBox x:Name="EncVidPresetBox" />
                      <TextBlock x:Name="PresetInfoLabel" Classes="dim" />
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="field" Text="Color Format" />
                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="EncVidColorsBox" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Classes="field" Text="Frame Rate" />
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="EncVidFpsBox" PlaceholderText="Keep original" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Classes="field" Text="Resize (W x H)" />
                    <Grid Grid.Row="7" Grid.Column="1" ColumnDefinitions="*,Auto,*" Margin="0,0,0,6">
                      <TextBox Grid.Column="0" x:Name="EncScaleBoxW" PlaceholderText="Auto" />
                      <TextBlock Grid.Column="1" Text="x" Margin="6,0" VerticalAlignment="Center" />
                      <TextBox Grid.Column="2" x:Name="EncScaleBoxH" PlaceholderText="Auto" />
                    </Grid>

                    <TextBlock Grid.Row="8" Grid.Column="0" Classes="field" Text="Crop" />
                    <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                      <ComboBox Grid.Column="0" x:Name="EncCropModeBox" SelectionChanged="EncCropMode_SelectionChanged">
                        <ComboBoxItem Content="Disabled" />
                        <ComboBoxItem Content="Automatic (detect black bars)" />
                        <ComboBoxItem Content="Manual" />
                      </ComboBox>
                      <Button Grid.Column="1" x:Name="EncCropConfBtn" Content="Configure…" IsVisible="False" Margin="6,0,0,0" Click="EncCropConf_Click" />
                    </Grid>

                    <TextBlock Grid.Row="9" Grid.Column="0" Classes="field" Text="Trim" />
                    <Button Grid.Row="9" Grid.Column="1" x:Name="EncTrimConfBtn" Content="Configure…" HorizontalAlignment="Left" Click="EncTrimConf_Click" />
                  </Grid>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Audio">
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Codec" />
                  <ComboBox Grid.Row="0" Grid.Column="1" x:Name="EncAudCodecBox" Margin="0,0,0,6" SelectionChanged="EncAudCodec_SelectionChanged" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Configuration" />
                  <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <ComboBox Grid.Column="0" x:Name="EncAudConfModeBox" SelectionChanged="EncAudConfMode_SelectionChanged">
                      <ComboBoxItem Content="Same settings for all tracks" />
                      <ComboBoxItem Content="Configure each track separately" />
                    </ComboBox>
                    <Button Grid.Column="1" x:Name="EncAudConfigureBtn" Content="Configure…" IsVisible="False" Margin="6,0,0,0" Click="EncAudConfigure_Click" />
                  </Grid>

                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Bitrate (Kbps)" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="EncAudQualUpDown" Minimum="0" Maximum="8192" Increment="8" Value="128" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Channels" />
                  <ComboBox Grid.Row="3" Grid.Column="1" x:Name="EncAudChannelsBox">
                    <ComboBoxItem Content="0 (Keep original)" />
                    <ComboBoxItem Content="1 (Mono)" />
                    <ComboBoxItem Content="2 (Stereo)" />
                    <ComboBoxItem Content="6 (5.1 Surround)" />
                    <ComboBoxItem Content="8 (7.1 Surround)" />
                  </ComboBox>
                </Grid>
              </TabItem>

              <TabItem Header="Subtitles">
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,*" Margin="4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Codec" />
                  <ComboBox Grid.Row="0" Grid.Column="1" x:Name="EncSubCodecBox" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Burn In" />
                  <ComboBox Grid.Row="1" Grid.Column="1" x:Name="EncSubBurnBox" />
                </Grid>
              </TabItem>

              <TabItem Header="Metadata">
                <Grid RowDefinitions="Auto,Auto,*" Margin="4">
                  <Grid Grid.Row="0" ColumnDefinitions="150,*,150,*" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Classes="field" Text="Copy Metadata From" />
                    <ComboBox Grid.Column="1" x:Name="EncMetaCopySource" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Classes="field" Text="Copy Chapters From" />
                    <ComboBox Grid.Column="3" x:Name="EncMetaChapterSource" />
                  </Grid>

                  <CheckBox Grid.Row="1" x:Name="EncMetaApplyGrid" Content="Apply the titles and languages below" IsChecked="True" Margin="0,0,0,6" />

                  <dg:DataGrid Grid.Row="2" x:Name="EncMetadataGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                               GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <dg:DataGrid.Columns>
                      <dg:DataGridTextColumn Header="Track" Binding="{Binding Field}" IsReadOnly="True" Width="2*" />
                      <dg:DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="5*" />
                      <dg:DataGridTextColumn Header="Lang" Binding="{Binding Language}" Width="Auto" MinWidth="80" />
                    </dg:DataGrid.Columns>
                  </dg:DataGrid>
                </Grid>
              </TabItem>

              <TabItem Header="Advanced">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="4">
                  <TextBlock Grid.Row="0" Classes="h" Text="Custom Arguments" />
                  <Grid Grid.Row="1" ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Input Args" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="EncCustomArgsIn" Margin="0,0,0,6" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Output Args" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="EncCustomArgsOut" />
                  </Grid>

                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,4">
                    <TextBlock Grid.Column="0" Classes="h" Text="Custom Video Filters" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Add" Margin="0,0,6,0" Click="EncFilterAdd_Click" />
                    <Button Grid.Column="2" Content="Remove" Click="EncFilterRemove_Click" />
                  </Grid>

                  <dg:DataGrid Grid.Row="4" x:Name="EncAdvancedFiltersGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                               GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <dg:DataGrid.Columns>
                      <dg:DataGridTextColumn Header="Filter" Binding="{Binding Filter}" Width="*" />
                    </dg:DataGrid.Columns>
                  </dg:DataGrid>
                </Grid>
              </TabItem>

            </TabControl>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
              <TextBlock Grid.Column="0" Classes="field" Text="Output Path" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" x:Name="OutputPathBox" />
                <Button Grid.Column="1" Content="…" Classes="icon" Margin="6,0,0,0" Click="BrowseFfmpegOutput_Click" />
              </Grid>
            </Grid>
          </Grid>
        </TabItem>

        <!-- ─────────── AV1AN ─────────── -->
        <TabItem Header="AV1AN">
          <Grid RowDefinitions="*,Auto" Margin="8">
            <TabControl Grid.Row="0" x:Name="Av1anTabs">

              <TabItem Header="Video">
                <ScrollViewer>
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Encoder" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Av1anCodecBox" Margin="0,0,0,6" SelectionChanged="Av1anCodec_SelectionChanged" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Container" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Av1anContainerBox" Margin="0,0,0,6" SelectionChanged="Av1anContainer_SelectionChanged" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Quality Mode" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Av1anQualModeBox" Margin="0,0,0,6" SelectionChanged="Av1anQualityMode_SelectionChanged" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Quality" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="Av1anQualityUpDown" Minimum="0" Maximum="100" Increment="1" Value="30" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="Preset / Effort" />
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="Av1anPresetBox" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="field" Text="Color Format" />
                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="Av1anColorSpaceBox" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Classes="field" Text="Grain Synthesis" />
                    <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                      <NumericUpDown Grid.Column="0" x:Name="Av1anGrainSynthStrengthUpDown" Minimum="0" Maximum="50" Increment="1" Value="0" />
                      <CheckBox Grid.Column="1" x:Name="Av1anGrainSynthDenoiseBox" Content="Denoise" Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Grid.Row="7" Grid.Column="0" Classes="field" Text="Frame Rate" />
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="Av1anFpsBox" PlaceholderText="Keep original" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Classes="field" Text="Resize (W x H)" />
                    <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="*,Auto,*" Margin="0,0,0,6">
                      <TextBox Grid.Column="0" x:Name="Av1anScaleBoxW" PlaceholderText="Auto" />
                      <TextBlock Grid.Column="1" Text="x" Margin="6,0" VerticalAlignment="Center" />
                      <TextBox Grid.Column="2" x:Name="Av1anScaleBoxH" PlaceholderText="Auto" />
                    </Grid>

                    <TextBlock Grid.Row="9" Grid.Column="0" Classes="field" Text="Crop" />
                    <Grid Grid.Row="9" Grid.Column="1" ColumnDefinitions="*,Auto">
                      <ComboBox Grid.Column="0" x:Name="Av1anCropBox" SelectionChanged="Av1anCrop_SelectionChanged">
                        <ComboBoxItem Content="Disabled" />
                        <ComboBoxItem Content="Automatic (detect black bars)" />
                        <ComboBoxItem Content="Manual" />
                      </ComboBox>
                      <Button Grid.Column="1" x:Name="Av1anCropConfBtn" Content="Configure…" IsVisible="False" Margin="6,0,0,0" Click="Av1anCropConf_Click" />
                    </Grid>
                  </Grid>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Audio &amp; Tracks">
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Codec" />
                  <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Av1anAudCodecBox" Margin="0,0,0,6" SelectionChanged="Av1anAudCodec_SelectionChanged" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Bitrate (Kbps)" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="Av1anAudQualUpDown" Minimum="0" Maximum="8192" Increment="8" Value="128" Margin="0,0,0,6" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Channels" />
                  <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Av1anAudChannelsBox" Margin="0,0,0,6">
                    <ComboBoxItem Content="0 (Keep original)" />
                    <ComboBoxItem Content="2 (Stereo)" />
                    <ComboBoxItem Content="6 (5.1 Surround)" />
                    <ComboBoxItem Content="8 (7.1 Surround)" />
                  </ComboBox>

                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Also Copy" />
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="CheckAv1anCopySubs" Content="Subtitles" IsChecked="True" />
                    <CheckBox x:Name="CheckAv1anCopyData" Content="Data Tracks" />
                    <CheckBox x:Name="CheckAv1anCopyAttachs" Content="Attachments" IsChecked="True" />
                  </StackPanel>
                </Grid>
              </TabItem>

              <TabItem Header="Av1an Options">
                <ScrollViewer>
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Split Method" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Av1anOptsSplitModeBox" Margin="0,0,0,6">
                      <ComboBoxItem Content="None" />
                      <ComboBoxItem Content="Scene Change Detection" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Chunk Method" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Av1anOptsChunkModeBox" Margin="0,0,0,6" SelectionChanged="Av1anOption_SelectionChanged" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Concat Method" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Av1anOptsConcatModeBox" Margin="0,0,0,6" SelectionChanged="Av1anOption_SelectionChanged">
                      <ComboBoxItem Content="MKVMerge" />
                      <ComboBoxItem Content="FFmpeg" />
                      <ComboBoxItem Content="IVF" />
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Chunk Order" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="Av1anOptsChunkOrderBox" Margin="0,0,0,6" SelectionChanged="Av1anOption_SelectionChanged">
                      <ComboBoxItem Content="Long-to-Short (Best CPU utilization)" />
                      <ComboBoxItem Content="Short-to-Long (Not very useful)" />
                      <ComboBoxItem Content="Sequential (Same order as input video)" />
                      <ComboBoxItem Content="Random (Most accurate filesize estimation)" />
                    </ComboBox>

                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="Workers" />
                    <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="Av1anOptsWorkerCountUpDown" Minimum="1" Maximum="64" Increment="1" Value="4" Margin="0,0,0,6" ValueChanged="Av1anOption_ValueChanged" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="field" Text="Threads per Worker" />
                    <NumericUpDown Grid.Row="5" Grid.Column="1" x:Name="Av1anThreadsUpDown" Minimum="1" Maximum="64" Increment="1" Value="2" Margin="0,0,0,6" ValueChanged="Av1anOption_ValueChanged" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Classes="field" Text="Custom av1an Args" />
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="Av1anCustomArgsBox" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Classes="field" Text="Custom Encoder Args" />
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="Av1anCustomEncArgsBox" />
                  </Grid>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Advanced">
                <Grid RowDefinitions="Auto,2*,Auto,*" Margin="4">
                  <TextBlock Grid.Row="0" Classes="h" Text="Encoder Arguments" />
                  <dg:DataGrid Grid.Row="1" x:Name="Av1anAdvancedArgsGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                               GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <dg:DataGrid.Columns>
                      <dg:DataGridTextColumn Header="Argument" Binding="{Binding Argument}" IsReadOnly="True" Width="2*" />
                      <dg:DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
                      <dg:DataGridTextColumn Header="Description, Possible Values" Binding="{Binding Description}" IsReadOnly="True" Width="5*" />
                    </dg:DataGrid.Columns>
                  </dg:DataGrid>

                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,4">
                    <TextBlock Grid.Column="0" Classes="h" Text="Custom Video Filters" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Add" Margin="0,0,6,0" Click="Av1anFilterAdd_Click" />
                    <Button Grid.Column="2" Content="Remove" Click="Av1anFilterRemove_Click" />
                  </Grid>

                  <dg:DataGrid Grid.Row="3" x:Name="Av1anAdvancedFiltersGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                               GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <dg:DataGrid.Columns>
                      <dg:DataGridTextColumn Header="Filter" Binding="{Binding Filter}" Width="*" />
                    </dg:DataGrid.Columns>
                  </dg:DataGrid>
                </Grid>
              </TabItem>

            </TabControl>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
              <TextBlock Grid.Column="0" Classes="field" Text="Output Path" />
              <TextBox Grid.Column="1" x:Name="Av1anOutputPathBox" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                <Button Content="…" Classes="icon" Click="BrowseAv1anOutput_Click" />
                <Button x:Name="Av1anResumeBtn" Content="Resume…" Click="Av1anResume_Click" />
                <Button x:Name="Av1anClearTempBtn" Content="Clear Temp…" Click="Av1anClearTemp_Click"
                        ToolTip.Tip="Delete the temporary files of every unfinished encode. They cannot be resumed afterwards." />
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>

        <!-- ─────────── Utilities ─────────── -->
        <TabItem Header="Utilities">
          <ScrollViewer>
            <StackPanel Margin="8" Spacing="8">
              <TextBlock Classes="dim" Text="Pick a utility, then press Run. Utilities are shortcuts for actions that normally need long CLI commands." />

              <Border x:Name="UtilsBitratesPanel" Classes="card" Tapped="SelectReadBitrates">
                <StackPanel>
                  <TextBlock Text="Read Bitrates" FontWeight="SemiBold" />
                  <TextBlock Classes="dim" Text="Calculates stream size and average bitrate for each selected track." />
                </StackPanel>
              </Border>

              <Border x:Name="UtilsMetricsPanel" Classes="card" Tapped="SelectGetMetrics">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Get Metrics" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="Configure…" Click="UtilsMetricsConf_Click" />
                  </Grid>
                  <TextBlock Classes="dim" Text="Calculate quality metrics like VMAF, SSIM and PSNR between two loaded files." />
                </StackPanel>
              </Border>

              <Border x:Name="UtilsColorDataPanel" Classes="card" Tapped="SelectColorData">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Transfer Color Metadata" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="Configure…" Click="UtilsColorDataConf_Click" />
                  </Grid>
                  <TextBlock Classes="dim" Text="Copy color properties and HDR metadata from one file to another." />
                </StackPanel>
              </Border>

              <Border x:Name="UtilsConcatPanel" Classes="card" Tapped="SelectConcat">
                <StackPanel>
                  <TextBlock Text="Concatenate Into Single MKV" FontWeight="SemiBold" />
                  <TextBlock Classes="dim" Text="Merge all loaded files into a single MKV without re-encoding." />
                </StackPanel>
              </Border>

              <Border x:Name="UtilsBitratePlotPanel" Classes="card" Tapped="SelectBitratePlot">
                <StackPanel>
                  <TextBlock Text="Show Bitrate Chart" FontWeight="SemiBold" />
                  <TextBlock Classes="dim" Text="Samples the bitrate across the whole video and plots it." />
                </StackPanel>
              </Border>

              <Border x:Name="UtilsOcrPanel" Classes="card" Tapped="SelectOcr">
                <StackPanel>
                  <TextBlock Text="OCR Bitmap Subtitles" FontWeight="SemiBold" />
                  <TextBlock Classes="dim" Text="Converts selected bitmap-based subtitle tracks into text subtitles." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ─────────── Settings ─────────── -->
        <TabItem Header="Settings">
          <ScrollViewer>
            <StackPanel Margin="8" Spacing="8">
              <TextBlock Classes="h" Text="General" />

              <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="After adding files" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TaskModeBox" Margin="0,0,0,6" SelectionChanged="TaskMode_SelectionChanged">
                  <ComboBoxItem Content="Wait for me to press Run" />
                  <ComboBoxItem Content="Run the selected task immediately" />
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Console window" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmdDebugModeBox" Margin="0,0,0,6" SelectionChanged="CmdDebugMode_SelectionChanged">
                  <ComboBoxItem Content="Hidden (Default)" />
                  <ComboBoxItem Content="Visible" />
                  <ComboBoxItem Content="Visible, stays open after finishing" />
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Auto-crop samples" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="AutoCropSamplesUpDown" Minimum="1" Maximum="100" Increment="1" Value="10" Margin="0,0,0,6" ValueChanged="GeneralSetting_ValueChanged" />

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Keyframe interval (s)" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="KeyIntSecsUpDown" Minimum="1" Maximum="120" Increment="1" Value="10" ValueChanged="GeneralSetting_ValueChanged" />
              </Grid>

              <CheckBox x:Name="UseZeroIndexedStreamsBox" Content="Show stream numbers zero-indexed (like ffmpeg does)" IsCheckedChanged="GeneralSetting_Changed" />
              <CheckBox x:Name="Mp4FaststartBox" Content="Web-optimize MP4 output (+faststart)" IsChecked="True" IsCheckedChanged="GeneralSetting_Changed" />
              <CheckBox x:Name="Av1anCmdVisibleBox" Content="Show the av1an console window" IsChecked="True" IsCheckedChanged="GeneralSetting_Changed" />

              <TextBlock Classes="h" Text="Reset On New File" />
              <Grid ColumnDefinitions="220,*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="field" Text="Settings to reset" />
                <TextBlock Grid.Column="1" x:Name="SettingsToResetLabel" VerticalAlignment="Center" Text="None" />
                <Button Grid.Column="2" Content="Configure…" Margin="6,0" Click="ResetSettingsConf_Click" />
                <Button Grid.Column="3" Content="Reset Now" Click="ResetSettingsResetAll_Click" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>

      <!-- ══════════════ Side panel: preview + log ══════════════ -->
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Classes="card" Padding="4">
          <Image x:Name="ThumbnailBox" Height="200" Stretch="Uniform" PointerPressed="Thumbnail_Click" />
        </Border>
        <TextBlock Grid.Row="1" x:Name="ThumbLabel" Classes="dim" Margin="2,4,2,6" />
        <TextBox Grid.Row="2" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="11" />
      </Grid>

    </Grid>

    <!-- ══════════════ Footer: progress + run controls ══════════════ -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="CurrentActionLabel" Classes="dim" />
        <ProgressBar x:Name="ProgBar" Minimum="0" Maximum="100" Height="8" Margin="0,4,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
        <Button x:Name="PauseBtn" Content="Pause" IsVisible="False" Click="Pause_Click" />
        <Button x:Name="StopBtn" Content="Stop" IsVisible="False" Click="Stop_Click" />
        <Button x:Name="RunBtn" Content="Run" MinWidth="120" FontWeight="SemiBold" Click="Run_Click" />
      </StackPanel>
    </Grid>

  </Grid>

</Window>
