<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nmkoder.App"
             RequestedThemeVariant="Dark">

  <!-- The palette is Discord's greys with an aquamarine accent: layers instead of black, text
       that stops short of white, one highlight color. Nothing in the app is #000 on #FFF except
       the log, which is meant to read like a terminal. -->
  <Application.Resources>

    <!-- ══════════════ Palette ══════════════ -->
    <!-- Surfaces, darkest to lightest. Sunken holds inputs and lists, Base is the window,
         Raised is the panel the tabs sit in, Hover/Active are the interaction states. -->
    <Color x:Key="NmkoderSunkenColor">#1E1F22</Color>
    <Color x:Key="NmkoderBaseColor">#2B2D31</Color>
    <Color x:Key="NmkoderRaisedColor">#313338</Color>
    <Color x:Key="NmkoderHoverColor">#383A40</Color>
    <Color x:Key="NmkoderActiveColor">#404249</Color>
    <Color x:Key="NmkoderBorderColor">#3F4147</Color>
    <Color x:Key="NmkoderBorderSubtleColor">#26282C</Color>

    <!-- Text. Primary is #DBDEE1, not white; headers get the one step brighter. -->
    <Color x:Key="NmkoderTextColor">#DBDEE1</Color>
    <Color x:Key="NmkoderHeaderTextColor">#F2F3F5</Color>
    <Color x:Key="NmkoderMutedTextColor">#949BA4</Color>
    <Color x:Key="NmkoderInteractiveColor">#B5BAC1</Color>

    <Color x:Key="NmkoderAccentColor">#9DE3DA</Color>
    <Color x:Key="NmkoderAccentHoverColor">#B6ECE5</Color>
    <Color x:Key="NmkoderAccentPressedColor">#81CFC5</Color>
    <!-- What goes on top of an accent fill. Nothing light is legible on aquamarine. -->
    <Color x:Key="NmkoderOnAccentColor">#102726</Color>
    <Color x:Key="NmkoderNeutralButtonColor">#4E5058</Color>
    <Color x:Key="NmkoderNeutralButtonHoverColor">#6D6F78</Color>
    <Color x:Key="NmkoderDangerColor">#DA373C</Color>

    <SolidColorBrush x:Key="NmkoderBackground" Color="{StaticResource NmkoderBaseColor}" />
    <SolidColorBrush x:Key="NmkoderPanel" Color="{StaticResource NmkoderRaisedColor}" />
    <SolidColorBrush x:Key="NmkoderSunken" Color="{StaticResource NmkoderSunkenColor}" />
    <SolidColorBrush x:Key="NmkoderHover" Color="{StaticResource NmkoderHoverColor}" />
    <SolidColorBrush x:Key="NmkoderBorder" Color="{StaticResource NmkoderBorderColor}" />
    <SolidColorBrush x:Key="NmkoderBorderSubtle" Color="{StaticResource NmkoderBorderSubtleColor}" />
    <SolidColorBrush x:Key="NmkoderText" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="NmkoderHeaderText" Color="{StaticResource NmkoderHeaderTextColor}" />
    <SolidColorBrush x:Key="NmkoderMutedText" Color="{StaticResource NmkoderMutedTextColor}" />
    <SolidColorBrush x:Key="NmkoderInteractive" Color="{StaticResource NmkoderInteractiveColor}" />
    <SolidColorBrush x:Key="NmkoderAccent" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="NmkoderAccentHover" Color="{StaticResource NmkoderAccentHoverColor}" />
    <SolidColorBrush x:Key="NmkoderAccentPressed" Color="{StaticResource NmkoderAccentPressedColor}" />
    <SolidColorBrush x:Key="NmkoderAccentSoft" Color="#339DE3DA" />
    <SolidColorBrush x:Key="NmkoderOnAccent" Color="{StaticResource NmkoderOnAccentColor}" />
    <SolidColorBrush x:Key="NmkoderNeutralButton" Color="{StaticResource NmkoderNeutralButtonColor}" />
    <SolidColorBrush x:Key="NmkoderNeutralButtonHover" Color="{StaticResource NmkoderNeutralButtonHoverColor}" />
    <SolidColorBrush x:Key="NmkoderDanger" Color="{StaticResource NmkoderDangerColor}" />

    <!-- Behind video frames, and over a panel that is temporarily out of bounds -->
    <SolidColorBrush x:Key="NmkoderVideoBackdrop" Color="#111214" />
    <SolidColorBrush x:Key="NmkoderScrim" Color="#D91E1F22" />

    <!-- The log is the stated exception: a terminal, so it keeps white on black. -->
    <SolidColorBrush x:Key="NmkoderLogBackground" Color="#000000" />
    <SolidColorBrush x:Key="NmkoderLogForeground" Color="#FFFFFF" />

    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <!-- ══════════════ Fluent overrides ══════════════ -->
    <!-- The palette below reaches the theme's own brushes; these are the leaf keys the control
         templates bind to directly, which the palette cannot reshape on its own. -->

    <!-- Buttons: Discord's neutral grey, not a washed-out translucent white -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource NmkoderNeutralButtonColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource NmkoderNeutralButtonHoverColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3E4045" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#2E3035" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource NmkoderHeaderTextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#72767D" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

    <!-- Text inputs sit below the surface they are on, the way Discord's do -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource NmkoderSunkenColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1A1B1E" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1A1B1E" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#26282C" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1A1B1E" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource NmkoderBorderColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#26282C" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource NmkoderHeaderTextColor}" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#72767D" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#72767D" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#72767D" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#72767D" />
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="{StaticResource NmkoderMutedTextColor}" />
    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="{StaticResource NmkoderHoverColor}" />
    <Color x:Key="TextControlSelectionHighlightColor">#9DE3DA</Color>

    <!-- Dropdowns: closed they read as inputs, open they float above everything -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource NmkoderSunkenColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource NmkoderSunkenColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1A1B1E" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#161719" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#26282C" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource NmkoderHeaderTextColor}" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{StaticResource NmkoderHeaderTextColor}" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#72767D" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1A1B1E" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource NmkoderBorderColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#26282C" />
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="#1A1B1E" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource NmkoderBaseColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource NmkoderBorderSubtleColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource NmkoderMutedTextColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#72767D" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource NmkoderHoverColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{StaticResource NmkoderActiveColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource NmkoderAccentHoverColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{StaticResource NmkoderAccentPressedColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource NmkoderHeaderTextColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource NmkoderOnAccentColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{StaticResource NmkoderOnAccentColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="{StaticResource NmkoderOnAccentColor}" />

    <!-- Tabs: no filled pill, just the accent pipe under the selected one -->
    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="Transparent" />
    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPressed" Color="Transparent" />
    <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselected" Color="Transparent" />
    <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPressed" Color="Transparent" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="{StaticResource NmkoderHeaderTextColor}" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="{StaticResource NmkoderMutedTextColor}" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPressed" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundDisabled" Color="#5C6068" />
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="{StaticResource NmkoderAccentColor}" />

    <!-- Ticked boxes are blurple; unticked ones are an outline, not a filled well -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource NmkoderAccentHoverColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource NmkoderAccentPressedColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#383A40" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#404249" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#6D6F78" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource NmkoderInteractiveColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="{StaticResource NmkoderInteractiveColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource NmkoderAccentHoverColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource NmkoderAccentPressedColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource NmkoderOnAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource NmkoderOnAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource NmkoderOnAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{StaticResource NmkoderHeaderTextColor}" />
    <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="{StaticResource NmkoderHeaderTextColor}" />

    <!-- Sliders and their track, used by the cut window's scrubber -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource NmkoderSunkenColor}" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#1A1B1E" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#1A1B1E" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource NmkoderAccentHoverColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource NmkoderAccentPressedColor}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource NmkoderHeaderTextColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF" />

    <!-- Tooltips and menus float on the darkest surface, with a hairline border -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="#111214" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource NmkoderBorderSubtleColor}" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource NmkoderBaseColor}" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource NmkoderBorderSubtleColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource NmkoderAccentPressedColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource NmkoderTextColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource NmkoderOnAccentColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource NmkoderOnAccentColor}" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="{StaticResource NmkoderBaseColor}" />
    <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="{StaticResource NmkoderBorderSubtleColor}" />

    <!-- Selection and hover, wherever the theme reaches for the accent itself -->
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{StaticResource NmkoderAccentHoverColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{StaticResource NmkoderAccentPressedColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightAltListAccentLowBrush" Color="{StaticResource NmkoderAccentColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightAltListAccentMediumBrush" Color="{StaticResource NmkoderAccentHoverColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightAltListAccentHighBrush" Color="{StaticResource NmkoderAccentPressedColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="{StaticResource NmkoderHoverColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="{StaticResource NmkoderActiveColor}" />
    <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush" Color="{StaticResource NmkoderHoverColor}" />
    <SolidColorBrush x:Key="SystemControlBackgroundListMediumBrush" Color="{StaticResource NmkoderActiveColor}" />

    <!-- Grids: header strip on the raised surface, rows and lines a shade apart -->
    <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="{StaticResource NmkoderBaseColor}" />
    <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="{StaticResource NmkoderHoverColor}" />
    <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="{StaticResource NmkoderActiveColor}" />
    <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="{StaticResource NmkoderMutedTextColor}" />
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="{StaticResource NmkoderBorderSubtleColor}" />
    <SolidColorBrush x:Key="DataGridFillerColumnGridLinesBrush" Color="{StaticResource NmkoderBorderSubtleColor}" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#599DE3DA" />
    <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#739DE3DA" />
    <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#599DE3DA" />
    <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#739DE3DA" />
    <SolidColorBrush x:Key="DataGridBorder" Color="{StaticResource NmkoderBorderSubtleColor}" />
    <SolidColorBrush x:Key="DataGridCellBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridDetailsPresenterBackgroundBrush" Color="Transparent" />

  </Application.Resources>

  <Application.Styles>
    <!-- Palettes repaints the theme's own brushes, so anything not overridden above - scrollbars,
         spinners, focus rings, disabled states - still lands on the Discord greys rather than
         Fluent's pure black and pure white. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark"
                               Accent="#9DE3DA"
                               RegionColor="#2B2D31"
                               AltHigh="#1E1F22"
                               AltLow="#331E1F22"
                               AltMedium="#991E1F22"
                               AltMediumHigh="#CC1E1F22"
                               AltMediumLow="#661E1F22"
                               BaseHigh="#DBDEE1"
                               BaseLow="#4E5058"
                               BaseMedium="#949BA4"
                               BaseMediumHigh="#C4C9CF"
                               BaseMediumLow="#72767D"
                               ChromeAltLow="#F2F3F5"
                               ChromeBlackHigh="#111214"
                               ChromeBlackLow="#33111214"
                               ChromeBlackMedium="#CC111214"
                               ChromeBlackMediumLow="#66111214"
                               ChromeDisabledHigh="#3F4147"
                               ChromeDisabledLow="#6D6F78"
                               ChromeGray="#949BA4"
                               ChromeHigh="#6D6F78"
                               ChromeLow="#232428"
                               ChromeMedium="#2B2D31"
                               ChromeMediumLow="#313338"
                               ChromeWhite="#FFFFFF"
                               ErrorText="#DA373C"
                               ListLow="#334E5058"
                               ListMedium="#664E5058" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- Nmkoder look: compact dark rows, layered surfaces, one accent -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource NmkoderBackground}" />
    </Style>

    <!-- Section headings. Small, spaced and muted, so they group without shouting. -->
    <Style Selector="TextBlock.h">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Foreground" Value="{DynamicResource NmkoderMutedText}" />
      <Setter Property="Margin" Value="0,8,0,2" />
    </Style>

    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource NmkoderMutedText}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource NmkoderInteractive}" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Explanatory text that sits next to a field instead of below it -->
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource NmkoderMutedText}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource NmkoderOnAccent}" />
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- Rows of a label/field form. The field column is a fixed width, so inputs stay
         readable instead of stretching across the whole window. -->
    <Style Selector="Grid.form > :is(Control)">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Inputs that only ever hold a few characters get sized to their content -->
    <Style Selector="NumericUpDown.num">
      <Setter Property="Width" Value="120" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="TextBox.num">
      <Setter Property="Width" Value="120" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="ComboBox.short">
      <Setter Property="Width" Value="140" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="ComboBox.wide">
      <Setter Property="Width" Value="520" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- The one button per screen that starts the work -->
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NmkoderAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource NmkoderOnAccent}" />
    </Style>

    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NmkoderAccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource NmkoderOnAccent}" />
    </Style>

    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NmkoderAccentPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource NmkoderOnAccent}" />
    </Style>

    <!-- Stopping is the destructive one, so it says so -->
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NmkoderDanger}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#A12829" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Header links and other buttons that should not compete with the real controls -->
    <Style Selector="Button.subtle /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource NmkoderMutedText}" />
    </Style>

    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NmkoderHover}" />
      <Setter Property="Foreground" Value="{DynamicResource NmkoderText}" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="32" />
    </Style>

    <!-- Lists and the grids sit in the sunken surface, below the panel they are on -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource NmkoderSunken}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NmkoderBorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource NmkoderOnAccent}" />
    </Style>

    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource NmkoderOnAccent}" />
    </Style>

    <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource NmkoderOnAccent}" />
    </Style>

    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{DynamicResource NmkoderSunken}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NmkoderBorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Cards: the tappable panels on the Utilities tab and the preview frames -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource NmkoderBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NmkoderBorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" />
    </Style>

    <Style Selector="Border.card:pointerover">
      <Setter Property="Background" Value="{DynamicResource NmkoderHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NmkoderBorder}" />
    </Style>

    <Style Selector="Border.card.selected">
      <Setter Property="Background" Value="{DynamicResource NmkoderAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NmkoderAccent}" />
    </Style>

    <!-- The raised surface the tabs sit on. Fluent's TabControl draws no panel of its own and
         ignores CornerRadius, so the rounding lives on a Border around it. -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource NmkoderPanel}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,4" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource NmkoderAccent}" />
      <Setter Property="Background" Value="{DynamicResource NmkoderSunken}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- The drag handle between the work area and the log: a divider, not a raised bar -->
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource NmkoderBorderSubtle}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource NmkoderAccent}" />
    </Style>

    <!-- The log is the exception the rest of the palette makes room for: a terminal, so it
         keeps the hard white-on-black contrast that makes a wall of output scannable. -->
    <Style Selector="TextBox.log">
      <Setter Property="Background" Value="{DynamicResource NmkoderLogBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource NmkoderLogForeground}" />
      <Setter Property="CaretBrush" Value="{DynamicResource NmkoderLogForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NmkoderBorderSubtle}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="TextBox.log:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource NmkoderLogBackground}" />
    </Style>

    <Style Selector="TextBox.log:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource NmkoderLogBackground}" />
    </Style>

    <!-- Read-only monospace panes (track details, command preview) -->
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Consolas,Menlo,DejaVu Sans Mono,monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>

</Application>
